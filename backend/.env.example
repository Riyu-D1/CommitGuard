# CommitGuard — copy this file to backend/.env and fill in real values.
# backend/.env is gitignored; never commit a real token.

# Live Slack mode — BOTH are required, otherwise the feed runs in
# simulated mode (cycling scenarios.json every 8s).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# 1 = post a threaded Block Kit warning per flagged message and a ✅
# reaction per clean one. 0/unset = monitor only, never writes to Slack.
SLACK_REPLY=1

# Optional — LLM enrichment stage. The app works fully without it.
OPENAI_API_KEY=
