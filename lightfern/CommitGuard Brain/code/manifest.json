{
  "manifestVersion": "2.4",
  "id": "commitguard-brain",
  "name": "CommitGuard Brain",
  "version": "1.0.0",
  "dependencies": { "react": "19.2.0", "react-dom": "19.2.0" },
  "permissions": ["files.read", "files.write"],
  "contributes": {
    "home": { "entry": "src/home.tsx", "title": "CommitGuard Brain" },
    "views": [
      {
        "match": "brain/policies/*.md",
        "entry": "src/policy.tsx",
        "title": "Policy"
      }
    ]
  }
}
